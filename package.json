{
  "name": "bb-plugin-backdrop",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Backdrop",
    "description": "Per-project thread backgrounds: Codex, OpenAI, Gemini or your own command draws a seamless monochrome pattern from each project, and bb shows it, transparent and theme-tinted, behind every thread.",
    "branding": {
      "icon": "./icons/image.svg",
      "experimental_icons": {
        "image": "./icons/image.svg",
        "sparkles": "./icons/sparkles.svg",
        "eye": "./icons/eye.svg",
        "eye-off": "./icons/eye-off.svg",
        "external": "./icons/external.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vitalio-sh/bb-plugin-backdrop.git"
  }
}
